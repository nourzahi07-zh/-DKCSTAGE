# ---------------------------------------------------------------------------
# DKC - environment variables
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# In Vercel, set the same variables in Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (public: safe in the browser, access is protected by RLS) ---
# Supabase dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Public URL of the site (used in auth e-mail links, metadata, sitemap) ---
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini (SERVER-ONLY: never prefix with NEXT_PUBLIC_) ---
# https://aistudio.google.com/apikey
# If empty, the chatbot still answers the fixed DKC questions and shows a
# friendly fallback for everything else; the rest of the site is unaffected.
GEMINI_API_KEY=
# Optional, defaults to gemini-3.6-flash
GEMINI_MODEL=
